{
  "info": {
    "name": "Complaint Management Portal API",
    "description": "Full API collection for the Complaint Management Portal (CMP). Covers Authentication, Departments, Categories, Complaints, Officer APIs, Admin APIs, and Notifications. See API_REFERENCE.md in the project root for full documentation of every field and validation rule.\n\nSetup:\n1. Set the `baseUrl` collection variable (defaults to http://localhost:5000/api/v1).\n2. Run 'Auth > Register (Citizen)' once, then 'Auth > Login (Citizen)' - this automatically stores the token in the `citizenToken` collection variable via a test script.\n3. Bootstrap an Admin with `npm run seed:admin` (see SEEDING_GUIDE.md), then run 'Auth > Login (Admin)' to populate `adminToken`.\n4. Use 'Admin > Update User (Promote to Officer)' on a registered citizen, then 'Auth > Login (Officer)' to populate `officerToken`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api/v1", "type": "string" },
    { "key": "citizenToken", "value": "", "type": "string" },
    { "key": "officerToken", "value": "", "type": "string" },
    { "key": "adminToken", "value": "", "type": "string" },
    { "key": "departmentId", "value": "", "type": "string" },
    { "key": "categoryId", "value": "", "type": "string" },
    { "key": "complaintId", "value": "", "type": "string" },
    { "key": "complaintTrackingId", "value": "", "type": "string" },
    { "key": "officerId", "value": "", "type": "string" },
    { "key": "notificationId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register (Citizen)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Citizen\",\n  \"email\": \"citizen@example.com\",\n  \"password\": \"password123\",\n  \"phone\": \"1234567890\"\n}"
            }
          }
        },
        {
          "name": "Register (Second user, to later promote to Officer)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sam Officer\",\n  \"email\": \"officer@example.com\",\n  \"password\": \"password123\",\n  \"phone\": \"9876543210\"\n}"
            }
          }
        },
        {
          "name": "Login (Citizen)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.data && json.data.token) {",
                  "  pm.collectionVariables.set('citizenToken', json.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"citizen@example.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Login (Officer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.data && json.data.token) {",
                  "  pm.collectionVariables.set('officerToken', json.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"officer@example.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Login (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.data && json.data.token) {",
                  "  pm.collectionVariables.set('adminToken', json.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@cmp.local\",\n  \"password\": \"Admin@12345\"\n}"
            },
            "description": "Requires an Admin account to already exist. Run `npm run seed:admin` on the server first (see SEEDING_GUIDE.md)."
          }
        },
        {
          "name": "Get Current User (Me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{citizenToken}}" }],
            "url": "{{baseUrl}}/auth/me"
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{citizenToken}}" }
            ],
            "url": "{{baseUrl}}/auth/change-password",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"password123\",\n  \"newPassword\": \"newPassword456\"\n}"
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{citizenToken}}" }],
            "url": "{{baseUrl}}/auth/logout"
          }
        }
      ]
    },
    {
      "name": "Departments",
      "item": [
        {
          "name": "List Departments",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{citizenToken}}" }],
            "url": "{{baseUrl}}/departments"
          }
        },
        {
          "name": "Create Department (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.data && json.data.department) {",
                  "  pm.collectionVariables.set('departmentId', json.data.department._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": "{{baseUrl}}/departments",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"departmentName\": \"Water Supply Department\"\n}"
            }
          }
        },
        {
          "name": "Update Department (Admin)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": "{{baseUrl}}/departments/{{departmentId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"departmentName\": \"Water Supply & Sanitation Department\"\n}"
            }
          }
        },
        {
          "name": "Delete Department (Admin)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/departments/{{departmentId}}"
          }
        }
      ]
    },
    {
      "name": "Categories",
      "item": [
        {
          "name": "List Categories",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{citizenToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/categories?department={{departmentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["categories"],
              "query": [{ "key": "department", "value": "{{departmentId}}" }]
            }
          }
        },
        {
          "name": "Create Category (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.data && json.data.category) {",
                  "  pm.collectionVariables.set('categoryId', json.data.category._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": "{{baseUrl}}/categories",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryName\": \"Pipeline Leak\",\n  \"department\": \"{{departmentId}}\"\n}"
            }
          }
        },
        {
          "name": "Update Category (Admin)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": "{{baseUrl}}/categories/{{categoryId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryName\": \"Pipeline Leak / Burst Pipe\",\n  \"department\": \"{{departmentId}}\"\n}"
            }
          }
        },
        {
          "name": "Delete Category (Admin)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/categories/{{categoryId}}"
          }
        }
      ]
    },
    {
      "name": "Complaints",
      "item": [
        {
          "name": "Create Complaint (Citizen, multipart with optional images)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.data && json.data.complaint) {",
                  "  pm.collectionVariables.set('complaintId', json.data.complaint._id);",
                  "  pm.collectionVariables.set('complaintTrackingId', json.data.complaint.complaintId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{citizenToken}}" }],
            "url": "{{baseUrl}}/complaints",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "title", "value": "Pipeline leak near school", "type": "text" },
                {
                  "key": "description",
                  "value": "A detailed description of a leaking pipe near the school gate.",
                  "type": "text"
                },
                { "key": "category", "value": "{{categoryId}}", "type": "text" },
                { "key": "department", "value": "{{departmentId}}", "type": "text" },
                { "key": "priority", "value": "High", "type": "text" },
                { "key": "address", "value": "5 Oak St", "type": "text" },
                { "key": "city", "value": "Springfield", "type": "text" },
                { "key": "state", "value": "IL", "type": "text" },
                { "key": "images", "type": "file", "src": [] }
              ]
            }
          }
        },
        {
          "name": "List Complaints",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{citizenToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/complaints?page=1&limit=10&sort=newest",
              "host": ["{{baseUrl}}"],
              "path": ["complaints"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "sort", "value": "newest" },
                { "key": "status", "value": "Pending", "disabled": true },
                { "key": "priority", "value": "High", "disabled": true },
                { "key": "department", "value": "{{departmentId}}", "disabled": true },
                { "key": "category", "value": "{{categoryId}}", "disabled": true },
                { "key": "dateFrom", "value": "2026-01-01", "disabled": true },
                { "key": "dateTo", "value": "2026-12-31", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Track Complaint by Tracking ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{citizenToken}}" }],
            "url": "{{baseUrl}}/complaints/track/{{complaintTrackingId}}"
          }
        },
        {
          "name": "Get Complaint Timeline",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{citizenToken}}" }],
            "url": "{{baseUrl}}/complaints/{{complaintId}}/timeline"
          }
        },
        {
          "name": "Get Complaint By Id",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{citizenToken}}" }],
            "url": "{{baseUrl}}/complaints/{{complaintId}}"
          }
        },
        {
          "name": "Update Complaint (owner only, while Pending)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{citizenToken}}" }
            ],
            "url": "{{baseUrl}}/complaints/{{complaintId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"priority\": \"Emergency\"\n}"
            }
          }
        },
        {
          "name": "Delete Complaint (soft delete)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{citizenToken}}" }],
            "url": "{{baseUrl}}/complaints/{{complaintId}}"
          }
        }
      ]
    },
    {
      "name": "Officer APIs",
      "item": [
        {
          "name": "List Assigned Complaints",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{officerToken}}" }],
            "url": "{{baseUrl}}/officer/complaints"
          }
        },
        {
          "name": "Update Complaint Status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{officerToken}}" }
            ],
            "url": "{{baseUrl}}/officer/complaints/{{complaintId}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"In Progress\",\n  \"remarks\": \"Investigating the leak\"\n}"
            }
          }
        },
        {
          "name": "Add Resolution Note",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{officerToken}}" }
            ],
            "url": "{{baseUrl}}/officer/complaints/{{complaintId}}/note",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resolutionNote\": \"Pipe section replaced, leak fully sealed.\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Admin APIs",
      "item": [
        {
          "name": "Dashboard Stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/admin/dashboard"
          }
        },
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/admin/users?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "users"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "role", "value": "officer", "disabled": true },
                { "key": "department", "value": "{{departmentId}}", "disabled": true },
                { "key": "search", "value": "officer@example.com", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Update User (Promote to Officer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.data && json.data.user) {",
                  "  pm.collectionVariables.set('officerId', json.data.user._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": "{{baseUrl}}/admin/users/REPLACE_WITH_USER_ID",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"officer\",\n  \"department\": \"{{departmentId}}\"\n}"
            },
            "description": "Replace REPLACE_WITH_USER_ID with the _id of a registered citizen (find it via 'Admin > List Users' filtered by search=officer@example.com)."
          }
        },
        {
          "name": "Deactivate User",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/admin/users/{{officerId}}"
          }
        },
        {
          "name": "Assign Complaint to Officer",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": "{{baseUrl}}/admin/complaints/{{complaintId}}/assign",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"officerId\": \"{{officerId}}\",\n  \"departmentId\": \"{{departmentId}}\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        {
          "name": "List Notifications",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.data && json.data.notifications && json.data.notifications.length) {",
                  "  pm.collectionVariables.set('notificationId', json.data.notifications[0]._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{citizenToken}}" }],
            "url": "{{baseUrl}}/notifications"
          }
        },
        {
          "name": "Mark Notification as Read",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{citizenToken}}" }],
            "url": "{{baseUrl}}/notifications/{{notificationId}}/read"
          }
        },
        {
          "name": "Delete Notification",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{citizenToken}}" }],
            "url": "{{baseUrl}}/notifications/{{notificationId}}"
          }
        }
      ]
    }
  ]
}
